# macOS
.DS_Store

# Editor swap/backup files
*.swp
*.swo
*~

# Python caches
__pycache__/
*.py[cod]

# Local agent project state (NOT the plugin manifest dir `.claude-plugin/`)
.claude/
.codex/
.remember/
.superpowers/
.playwright-screenshots/

# Generated review artifacts (user's local output — not part of the plugin)
**/docs/code-reviews/

# Bun build artifacts
*.bun-build
.*.bun-build

# Bun workspace
node_modules/
packages/*/node_modules/
apps/*/node_modules/
!apps/vscode-extension/.vscode/
!apps/vscode-extension/.vscode/**
!apps/vscode-extension/bin/
!apps/vscode-extension/bin/**
apps/vscode-extension/dist/
apps/vscode-extension/*.vsix
packages/client/dist/
packages/client/.vite/
bun.lockb
dist/
dev-mock.sh

# Runtime artifacts written by the server when pointed at fixture dirs
tests/fixtures/smoke/**/decisions.json
tests/fixtures/smoke/**/auto-resume.json
tests/fixtures/smoke/**/resume-artifact.json
tests/fixtures/smoke/**/ui-port
