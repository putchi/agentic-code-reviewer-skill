  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/code-review-gate.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
