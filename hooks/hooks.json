{
  "description": "Agentic code reviewer - prompts or gates session exit based on user settings; notifies on update",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/code-review-gate.sh",
            "timeout": 210
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/check-update.sh",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
